-        [[ $owner == apache2 ]] && mapped=apache
-        if [[ $mapped != "$choice" ]]; then ui_msg "$title" "$(t web.port_busy "$owner" "$owner")"; return 1; fi
-      fi ;;
-    *) ui_msg "$title" "$(t web.port_busy "$owner" "$owner")"; return 1 ;;
